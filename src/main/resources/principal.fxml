<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="PrincipalController"
    spacing="15.0"
    alignment="TOP_CENTER">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <ImageView layoutX="5"
               layoutY="5"
               fitWidth="1536"
               fitHeight="400"
               preserveRatio="false">

        <Image url="assets/images/BannerMenu.png"/>

    </ImageView>

    <Region prefHeight="20.0"/>

    <Button text="Jefes" fx:id="btnJefes" onAction="#actJefes" focusTraversable="false"/>
    <Button text="Oleadas" fx:id="btnOleadas" onAction="#actOleadas" focusTraversable="false"/>
    <Button text="Tienda" fx:id="btnTienda" onAction="#actTienda" focusTraversable="false"/>

</VBox>