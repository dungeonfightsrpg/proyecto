<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.control.TextField?>
<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="registroController"
            prefWidth="800"
            prefHeight="600"
            style="-fx-background-color: grey;">

    <ImageView fitWidth="100"
               fitHeight="100"
               preserveRatio="true"
               layoutX="10"
               layoutY="10">

        <image>
            <Image url="@imagenes/logo1.png"/>
        </image>

    </ImageView>
    <Label text="Iniciar sesión"
           layoutX="60"
           layoutY="120"
            textFill="white"
           style="-fx-font-family: 'Times New Roman';
    -fx-font-size: 25px;"/>

    <Label
    text="Usuario"
    textFill="white"
    layoutX="50"
    layoutY="200"
    style="-fx-font-family: 'Times New Roman';
    -fx-font-size: 12px;"

    ></Label>

    <TextField
        layoutX="50"
        layoutY="220"
        style="-fx-font-family: 'Times New Roman';
    -fx-font-size: 12px;"
    ></TextField>
    <Label text="Contraseña"
           textFill="white"
           layoutX="50"
           layoutY="250"
           style="-fx-font-family: 'Times New Roman';
    -fx-font-size: 12px;"/>

    <TextField
            layoutX="50"
            layoutY="270"
            style="-fx-font-family: 'Times New Roman';
    -fx-font-size: 12px;"
    ></TextField>
</AnchorPane>